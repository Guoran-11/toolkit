# ============================================================================
# 环境变量样例 —— 复制为 .env 后按需修改
#
# 仅 docker compose 与 CI 会读取本文件；直接 `python run.py` 运行时，
# 请改 config.toml。两者的优先级：环境变量 > config.toml > 内置默认值。
#
# ⚠️ 安全提醒：.env 内含凭据，切勿提交到版本库（.gitignore 已忽略）。
# ============================================================================

# ---------------------------------------------------------------- 监听
# 宿主机绑定的网卡：127.0.0.1 仅本机；0.0.0.0 对内网/公网开放
BIND_ADDR=127.0.0.1
HOST_PORT=5000

# ---------------------------------------------------------------- 鉴权
# 对外暴露时**必须**为 true。这是风险 R6（默认口令 + 无限重试）的第一道防线。
AUTH_REQUIRED=true
ADMIN_USERNAME=admin
# 留空 = 首次启动自动生成随机密码并打印到容器日志
ADMIN_PASSWORD=

# ---------------------------------------------------------------- 限额
MAX_UPLOAD_MB=100
# 音频模块单文件上限（MB），独立于上面的通用上限
MAX_AUDIO_UPLOAD_MB=200
WORKERS=4
# 产物保留时长（小时），到期自动清理
OUTPUT_TTL_HOURS=24

# ---------------------------------------------------------------- 模块开关
# SSH 终端默认关闭，避免误开成为公网跳板
SSH_ENABLED=false
# 视频下载：容器/公网部署默认关闭（平台 ToS 与当地法律风险由部署者承担）。
# 仅本机或内网自用时可置 true；开启前请阅读 README「视频下载」章节的合规说明。
VIDEO_ENABLED=false
# 视频下载并发数与单文件上限（MB）
VIDEO_MAX_CONCURRENT=2
VIDEO_MAX_FILE_MB=2048

# ---------------------------------------------------------------- 引擎
# 置 1 则在镜像内安装 LibreOffice + FFmpeg（镜像 +700MB）
WITH_ENGINES=0

# ---------------------------------------------------------------- 资源与区域
CPU_LIMIT=2.0
MEM_LIMIT=2g
TZ=Asia/Shanghai
